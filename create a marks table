CREATE TABLE MARKS (
    MARK_ID NUMBER PRIMARY KEY,
    STUDENT_ID NUMBER,
    SUBJECT_ID NUMBER,
    MARKS_OBTAINED NUMBER,
    CONSTRAINT FK_STUDENT
        FOREIGN KEY (STUDENT_ID)
        REFERENCES STUDENTS(STUDENT_ID),
    CONSTRAINT FK_SUBJECT
        FOREIGN KEY (SUBJECT_ID)
        REFERENCES SUBJECTS(SUBJECT_ID)
);
